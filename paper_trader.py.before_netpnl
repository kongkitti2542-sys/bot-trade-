from datetime import datetime, timezone

from capital_config import STARTING_CAPITAL_USDT

from database import (
    initialize_database,
    get_account_state,
    save_account_state,
    get_open_position,
    save_open_position,
    delete_open_position,
    save_trade,
)


class PaperTrader:

    def __init__(self, starting_capital=STARTING_CAPITAL_USDT):
        initialize_database()

        account_state = get_account_state()

        if account_state is None:
            now = datetime.now(timezone.utc).isoformat()

            self.starting_capital = starting_capital
            self.capital = starting_capital
            self.daily_pnl = 0.0

            save_account_state(
                starting_capital=self.starting_capital,
                capital=self.capital,
                daily_pnl=self.daily_pnl,
                updated_at=now,
            )
        else:
            self.starting_capital = account_state["starting_capital"]
            self.capital = account_state["capital"]
            self.daily_pnl = account_state["daily_pnl"]

        self.position = get_open_position()

    def open_position(
        self,
        symbol,
        side,
        price,
        position_size,
        position_value,
        stop_loss,
        decision
    ):

        if self.position is not None:
            return False, "POSITION_ALREADY_OPEN"

        position = {
            "symbol": symbol,
            "side": side,
            "entry_price": price,
            "position_size": position_size,
            "position_value": position_value,
            "stop_loss": stop_loss,
            "strategy_score": decision["score"],
            "confidence": decision["confidence"],
            "regime": decision["regime"],
            "reason": ", ".join(decision["reasons"]),
            "opened_at": datetime.now(timezone.utc).isoformat(),
        }

        save_open_position(position)

        self.position = get_open_position()

        if self.position is None:
            return False, "POSITION_SAVE_FAILED"

        return True, "POSITION_OPENED"

    def close_position(
        self,
        price,
        exit_reason
    ):

        if self.position is None:
            return False, "NO_POSITION"

        position = self.position

        entry = position["entry_price"]
        size = position["position_size"]
        side = position["side"]

        if side == "BUY":
            pnl = (price - entry) * size

        elif side == "SELL":
            pnl = (entry - price) * size

        else:
            return False, "INVALID_SIDE"

        new_capital = self.capital + pnl
        new_daily_pnl = self.daily_pnl + pnl

        trade = {
            "timestamp": datetime.now(timezone.utc).isoformat(),

            "symbol": position["symbol"],
            "side": side,
            "status": "CLOSED",

            "entry_price": entry,
            "exit_price": price,

            "position_size": size,
            "position_value": position["position_value"],

            "stop_loss": position["stop_loss"],

            "pnl": pnl,

            "strategy_score": position["strategy_score"],
            "confidence": position["confidence"],
            "regime": position["regime"],

            "reason": position["reason"],
            "exit_reason": exit_reason,
        }

        save_trade(trade)

        delete_open_position(position["id"])

        save_account_state(
            starting_capital=self.starting_capital,
            capital=new_capital,
            daily_pnl=new_daily_pnl,
            updated_at=datetime.now(timezone.utc).isoformat(),
        )

        self.capital = new_capital
        self.daily_pnl = new_daily_pnl
        self.position = None

        return True, trade


